    { "id": "supervisor", "lane": "agents", "col": 0, "type": "backend", "label": "Supervisor", "sublabel": "Deep Agent", "width": 132 },
    { "id": "researcher", "lane": "agents", "col": 1, "type": "backend", "label": "Researcher", "sublabel": "enriches the lead", "width": 132 },
    { "id": "qualifier", "lane": "agents", "col": 2, "type": "backend", "label": "Qualifier", "sublabel": "hot, warm or cold", "width": 132 },
    { "id": "writer", "lane": "agents", "col": 3, "type": "backend", "label": "Writer", "sublabel": "drafts the email", "width": 132 },
    { "id": "guardrail", "lane": "safety", "col": 3, "type": "security", "label": "Guardrail", "sublabel": "checks the draft", "width": 132 },
